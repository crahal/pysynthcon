include README.md CHANGELOG.md CONTRIBUTING.md CITATION.cff THIRD_PARTY_NOTICES.md
include requirements-replication.txt
recursive-include docs *.md *.rst *.py
include docs/assets/pysynthcon-header.svg docs/assets/pysynthcon-header-compact.svg
prune docs/_build
include empirical_examples/basque.ipynb empirical_examples/california.ipynb
include empirical_examples/germany.ipynb empirical_examples/kansas.ipynb
include simulated_examples/donor_spillovers.ipynb
prune outputs
prune empirical_examples/figures
prune empirical_examples/baselines
include scripts/create_notebooks.py scripts/execute_notebooks.py
exclude scripts/install_r_references.py scripts/validate_r.py scripts/validate_sdid_inference.py
exclude scripts/r-reference-lock.json
recursive-include tests *.py *.json
prune .local
prune src/pysynth/_reference
global-exclude *.R *.r *.RData *.rdata *.rds *.rda *.executed.ipynb
global-exclude __pycache__ *.py[cod]
